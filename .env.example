# Application Environment Configuration
# Copy this file to .env and adjust values for local development.
# NEVER commit actual secrets or credentials to source control.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mcp_invoice
REDIS_URL=redis://localhost:6379/0

# Base64-encoded 32-byte key for Fernet symmetric encryption of tenant credentials at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=k5_3sZ8XfD-t4K3qR8W1yU9vX2zL7nB4mQ6pP0oI8aE=

# Digital Invoicing Software integration config
DIGITAL_INVOICING_BASE_URL=https://www.digitalinvoicingsoftware.com
DIGITAL_INVOICING_ENV=sandbox

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
